# PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App connection (NestJS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT secret
JWT_SECRET=your_jwt_secret

# POSTGRES_PASSWORD → used by the Postgres container to create the database user.

# DB_PASSWORD → used by your NestJS app to connect to Postgres.

# Make sure to set strong passwords and secrets in a production environment.